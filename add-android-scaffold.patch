diff --git a/app/src/main/java/com/gymbagrut/ui/trainer/TrainerDashboardActivity.java b/app/src/main/java/com/gymbagrut/ui/trainer/TrainerDashboardActivity.java
new file mode 100644
index 0000000000000000000000000000000000000000..886d0a5f5ea86e50c134b2d8a0182d811407b581
--- /dev/null
+++ b/app/src/main/java/com/gymbagrut/ui/trainer/TrainerDashboardActivity.java
@@ -0,0 +1,153 @@
+package com.gymbagrut.ui.trainer;
+
+import android.os.Bundle;
+import android.view.View;
+import android.widget.ProgressBar;
+import android.widget.TextView;
+import android.widget.Toast;
+
+import androidx.annotation.Nullable;
+import androidx.appcompat.app.AppCompatActivity;
+import androidx.recyclerview.widget.LinearLayoutManager;
+import androidx.recyclerview.widget.RecyclerView;
+
+import com.gymbagrut.R;
+import com.gymbagrut.data.callbacks.DataCallback;
+import com.gymbagrut.data.callbacks.ListDataCallback;
+import com.gymbagrut.data.model.TrainingPackage;
+import com.gymbagrut.data.model.TrainingPurchase;
+import com.gymbagrut.data.model.UserProfile;
+import com.gymbagrut.data.repository.PackageRepository;
+import com.gymbagrut.ui.packageeditor.PackageEditorActivity;
+import com.gymbagrut.ui.trainer.adapters.TrainerClientAdapter;
+import com.gymbagrut.ui.trainer.adapters.TrainerPackageAdapter;
+import com.google.android.material.appbar.MaterialToolbar;
+import com.google.android.material.floatingactionbutton.FloatingActionButton;
+
+import java.util.List;
+
+/**
+ * Dashboard for trainers to manage their packages and review client progression.
+ */
+public class TrainerDashboardActivity extends AppCompatActivity implements TrainerPackageAdapter.PackageInteractionListener {
+
+    private UserProfile trainerProfile;
+    private PackageRepository packageRepository;
+    private TrainerPackageAdapter packageAdapter;
+    private TrainerClientAdapter clientAdapter;
+    private ProgressBar packageProgressBar;
+    private ProgressBar clientsProgressBar;
+    private TextView packageEmptyView;
+    private TextView clientsEmptyView;
+
+    @Override
+    protected void onCreate(@Nullable Bundle savedInstanceState) {
+        super.onCreate(savedInstanceState);
+        setContentView(R.layout.activity_trainer_dashboard);
+        trainerProfile = (UserProfile) getIntent().getSerializableExtra("user_profile");
+        if (trainerProfile == null) {
+            finish();
+            return;
+        }
+        packageRepository = new PackageRepository();
+        initViews();
+        setupRecyclerViews();
+    }
+
+    @Override
+    protected void onResume() {
+        super.onResume();
+        loadPackages();
+        loadClients();
+    }
+
+    private void initViews() {
+        MaterialToolbar toolbar = findViewById(R.id.trainerToolbar);
+        setSupportActionBar(toolbar);
+        TextView trainerName = findViewById(R.id.trainerWelcomeText);
+        trainerName.setText(getString(R.string.trainer_welcome_format, trainerProfile.getFirstName()));
+        packageProgressBar = findViewById(R.id.trainerPackagesProgress);
+        clientsProgressBar = findViewById(R.id.trainerClientsProgress);
+        packageEmptyView = findViewById(R.id.trainerPackagesEmptyView);
+        clientsEmptyView = findViewById(R.id.trainerClientsEmptyView);
+        FloatingActionButton createPackageButton = findViewById(R.id.trainerCreatePackageButton);
+        createPackageButton.setOnClickListener(new View.OnClickListener() {
+            @Override
+            public void onClick(View v) {
+                PackageEditorActivity.start(TrainerDashboardActivity.this, trainerProfile, null);
+            }
+        });
+    }
+
+    private void setupRecyclerViews() {
+        RecyclerView packagesRecycler = findViewById(R.id.trainerPackagesRecycler);
+        RecyclerView clientsRecycler = findViewById(R.id.trainerClientsRecycler);
+        packagesRecycler.setLayoutManager(new LinearLayoutManager(this));
+        clientsRecycler.setLayoutManager(new LinearLayoutManager(this));
+        packageAdapter = new TrainerPackageAdapter(this);
+        clientAdapter = new TrainerClientAdapter();
+        packagesRecycler.setAdapter(packageAdapter);
+        clientsRecycler.setAdapter(clientAdapter);
+    }
+
+    private void loadPackages() {
+        packageProgressBar.setVisibility(View.VISIBLE);
+        packageRepository.fetchTrainerPackages(trainerProfile.getUid(), new ListDataCallback<TrainingPackage>() {
+            @Override
+            public void onSuccess(List<TrainingPackage> data) {
+                packageProgressBar.setVisibility(View.GONE);
+                packageEmptyView.setVisibility(data.isEmpty() ? View.VISIBLE : View.GONE);
+                packageAdapter.updateData(data);
+            }
+
+            @Override
+            public void onError(String message) {
+                packageProgressBar.setVisibility(View.GONE);
+                packageEmptyView.setVisibility(View.VISIBLE);
+                Toast.makeText(TrainerDashboardActivity.this, message, Toast.LENGTH_LONG).show();
+            }
+        });
+    }
+
+    private void loadClients() {
+        clientsProgressBar.setVisibility(View.VISIBLE);
+        packageRepository.fetchPurchasesForTrainer(trainerProfile.getUid(), new ListDataCallback<TrainingPurchase>() {
+            @Override
+            public void onSuccess(List<TrainingPurchase> data) {
+                clientsProgressBar.setVisibility(View.GONE);
+                clientsEmptyView.setVisibility(data.isEmpty() ? View.VISIBLE : View.GONE);
+                clientAdapter.updateData(data);
+            }
+
+            @Override
+            public void onError(String message) {
+                clientsProgressBar.setVisibility(View.GONE);
+                clientsEmptyView.setVisibility(View.VISIBLE);
+                Toast.makeText(TrainerDashboardActivity.this, message, Toast.LENGTH_LONG).show();
+            }
+        });
+    }
+
+    @Override
+    public void onEditPackage(TrainingPackage trainingPackage) {
+        PackageEditorActivity.start(this, trainerProfile, trainingPackage);
+    }
+
+    @Override
+    public void onToggleStatus(final TrainingPackage trainingPackage) {
+        trainingPackage.setStatus(trainingPackage.isActive() ? "inactive" : "active");
+        packageRepository.savePackage(trainingPackage, new DataCallback<TrainingPackage>() {
+            @Override
+            public void onSuccess(TrainingPackage data) {
+                Toast.makeText(TrainerDashboardActivity.this, R.string.trainer_package_status_updated,
+                        Toast.LENGTH_SHORT).show();
+                loadPackages();
+            }
+
+            @Override
+            public void onError(String message) {
+                Toast.makeText(TrainerDashboardActivity.this, message, Toast.LENGTH_LONG).show();
+            }
+        });
+    }
+}
