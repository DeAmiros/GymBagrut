+package com.gymbagrut.ui.trainer.adapters;
+
+import android.view.LayoutInflater;
+import android.view.View;
+import android.view.ViewGroup;
+import android.widget.TextView;
+
+import androidx.annotation.NonNull;
+import androidx.recyclerview.widget.RecyclerView;
+
+import com.gymbagrut.R;
+import com.gymbagrut.data.model.TrainingPurchase;
+
+import java.util.ArrayList;
+import java.util.List;
+
+/**
+ * Adapter that lists purchases for a trainer giving insight into trainee progress.
+ */
+public class TrainerClientAdapter extends RecyclerView.Adapter<TrainerClientAdapter.ClientViewHolder> {
+
+    private final List<TrainingPurchase> purchases;
+
+    public TrainerClientAdapter() {
+        purchases = new ArrayList<>();
+    }
+
+    public void updateData(List<TrainingPurchase> newPurchases) {
