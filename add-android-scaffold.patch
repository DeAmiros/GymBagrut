@@ -0,0 +1,215 @@
+package com.gymbagrut.data.repository;
+
+import androidx.annotation.NonNull;
+
+import com.gymbagrut.data.callbacks.CompletionCallback;
+import com.gymbagrut.data.callbacks.DataCallback;
+import com.gymbagrut.data.firebase.FirebasePaths;
+import com.gymbagrut.data.model.TeacherDetails;
+import com.gymbagrut.data.model.UserProfile;
+import com.google.android.gms.tasks.OnCompleteListener;
+import com.google.android.gms.tasks.Task;
+import com.google.firebase.auth.AuthResult;
+import com.google.firebase.auth.FirebaseAuth;
+import com.google.firebase.auth.FirebaseUser;
+import com.google.firebase.database.DataSnapshot;
+import com.google.firebase.database.DatabaseError;
+import com.google.firebase.database.DatabaseReference;
+import com.google.firebase.database.FirebaseDatabase;
+import com.google.firebase.database.ValueEventListener;
+
+/**
+ * Handles the authentication flows and bridges them with the persisted user profiles.
+ */
+public class AuthRepository {
+
+    private final FirebaseAuth firebaseAuth;
+    private final DatabaseReference databaseReference;
+
+    public AuthRepository() {
+        firebaseAuth = FirebaseAuth.getInstance();
+        databaseReference = FirebaseDatabase.getInstance().getReference();
+    }
+
+    public FirebaseUser getCurrentUser() {
+        return firebaseAuth.getCurrentUser();
+    }
+
+    public void signOut() {
+        firebaseAuth.signOut();
+    }
+
+    public void login(String email, String password, final DataCallback<UserProfile> callback) {
+        firebaseAuth.signInWithEmailAndPassword(email, password)
+                .addOnCompleteListener(new OnCompleteListener<AuthResult>() {
+                    @Override
+                    public void onComplete(@NonNull Task<AuthResult> task) {
+                        if (task.isSuccessful() && firebaseAuth.getCurrentUser() != null) {
+                            fetchProfile(firebaseAuth.getCurrentUser().getUid(), callback);
+                        } else {
+                            String message = task.getException() != null
+                                    ? task.getException().getMessage()
+                                    : "Unable to sign in. Please try again.";
+                            callback.onError(message);
+                        }
+                    }
+                });
+    }
+
+    public void registerTrainee(final UserProfile profile, String password,
+                                final DataCallback<UserProfile> callback) {
+        firebaseAuth.createUserWithEmailAndPassword(profile.getEmail(), password)
+                .addOnCompleteListener(new OnCompleteListener<AuthResult>() {
+                    @Override
+                    public void onComplete(@NonNull Task<AuthResult> task) {
+                        if (!task.isSuccessful() || firebaseAuth.getCurrentUser() == null) {
+                            String message = task.getException() != null
+                                    ? task.getException().getMessage()
+                                    : "Registration failed.";
+                            callback.onError(message);
+                            return;
+                        }
+
+                        FirebaseUser user = firebaseAuth.getCurrentUser();
+                        profile.setUid(user.getUid());
+                        profile.setRole("trainee");
+                        profile.setStatus("active");
+                        profile.setCreatedAt(System.currentTimeMillis());
+                        if (profile.getTeacherId() == null) {
+                            profile.setTeacherId("0");
+                        }
+
+                        databaseReference.child(FirebasePaths.USERS)
+                                .child(profile.getUid())
+                                .setValue(profile)
+                                .addOnCompleteListener(new OnCompleteListener<Void>() {
+                                    @Override
+                                    public void onComplete(@NonNull Task<Void> userTask) {
+                                        if (userTask.isSuccessful()) {
+                                            callback.onSuccess(profile);
+                                        } else {
+                                            String message = userTask.getException() != null
+                                                    ? userTask.getException().getMessage()
+                                                    : "Unable to store profile.";
+                                            callback.onError(message);
+                                        }
+                                    }
+                                });
+                    }
+                });
+    }
+
+    public void registerTrainer(final UserProfile trainerProfile,
+                                final TeacherDetails teacherDetails,
+                                final String trainerPassword,
+                                final String adminEmail,
+                                final String adminPassword,
+                                final DataCallback<UserProfile> callback) {
+        firebaseAuth.createUserWithEmailAndPassword(trainerProfile.getEmail(), trainerPassword)
+                .addOnCompleteListener(new OnCompleteListener<AuthResult>() {
+                    @Override
+                    public void onComplete(@NonNull Task<AuthResult> task) {
+                        if (!task.isSuccessful() || firebaseAuth.getCurrentUser() == null) {
+                            String message = task.getException() != null
+                                    ? task.getException().getMessage()
+                                    : "Unable to create trainer account.";
+                            callback.onError(message);
+                            return;
+                        }
+
+                        final FirebaseUser trainerUser = firebaseAuth.getCurrentUser();
+                        trainerProfile.setUid(trainerUser.getUid());
+                        trainerProfile.setTeacherId(trainerUser.getUid());
+                        trainerProfile.setRole("trainer");
+                        trainerProfile.setStatus("active");
+                        trainerProfile.setCreatedAt(System.currentTimeMillis());
+
+                        teacherDetails.setTeacherUid(trainerUser.getUid());
+                        teacherDetails.setUserId(trainerUser.getUid());
+
+                        databaseReference.child(FirebasePaths.USERS)
+                                .child(trainerUser.getUid())
+                                .setValue(trainerProfile)
+                                .addOnCompleteListener(new OnCompleteListener<Void>() {
+                                    @Override
+                                    public void onComplete(@NonNull Task<Void> profileTask) {
+                                        if (!profileTask.isSuccessful()) {
+                                            String message = profileTask.getException() != null
+                                                    ? profileTask.getException().getMessage()
+                                                    : "Failed to store trainer profile.";
+                                            callback.onError(message);
+                                            return;
+                                        }
+
+                                        databaseReference.child(FirebasePaths.TEACHER_DETAILS)
+                                                .child(trainerUser.getUid())
+                                                .setValue(teacherDetails)
+                                                .addOnCompleteListener(new OnCompleteListener<Void>() {
+                                                    @Override
+                                                    public void onComplete(@NonNull Task<Void> detailsTask) {
+                                                        if (!detailsTask.isSuccessful()) {
+                                                            String message = detailsTask.getException() != null
+                                                                    ? detailsTask.getException().getMessage()
+                                                                    : "Unable to store trainer details.";
+                                                            callback.onError(message);
+                                                            return;
+                                                        }
+
+                                                        firebaseAuth.signInWithEmailAndPassword(adminEmail, adminPassword)
+                                                                .addOnCompleteListener(new OnCompleteListener<AuthResult>() {
+                                                                    @Override
+                                                                    public void onComplete(@NonNull Task<AuthResult> adminLoginTask) {
+                                                                        if (adminLoginTask.isSuccessful()) {
+                                                                            callback.onSuccess(trainerProfile);
+                                                                        } else {
+                                                                            String message = adminLoginTask.getException() != null
+                                                                                    ? adminLoginTask.getException().getMessage()
+                                                                                    : "Trainer created but admin sign-in failed.";
+                                                                            callback.onError(message);
+                                                                        }
+                                                                    }
+                                                                });
+                                                    }
+                                                });
+                                    }
+                                });
+                    }
+                });
+    }
+
+    public void sendPasswordReset(String email, final CompletionCallback callback) {
+        firebaseAuth.sendPasswordResetEmail(email)
+                .addOnCompleteListener(new OnCompleteListener<Void>() {
+                    @Override
+                    public void onComplete(@NonNull Task<Void> task) {
+                        boolean success = task.isSuccessful();
+                        String message = success ? "Password reset email sent." :
+                                task.getException() != null
+                                        ? task.getException().getMessage()
+                                        : "Unable to send reset email.";
+                        callback.onComplete(success, message);
+                    }
+                });
+    }
+
+    public void fetchProfile(String uid, final DataCallback<UserProfile> callback) {
+        databaseReference.child(FirebasePaths.USERS)
+                .child(uid)
+                .addListenerForSingleValueEvent(new ValueEventListener() {
+                    @Override
+                    public void onDataChange(@NonNull DataSnapshot snapshot) {
+                        UserProfile profile = snapshot.getValue(UserProfile.class);
+                        if (profile != null) {
+                            callback.onSuccess(profile);
+                        } else {
+                            callback.onError("Profile not found for the authenticated user.");
+                        }
+                    }
+
+                    @Override
+                    public void onCancelled(@NonNull DatabaseError error) {
+                        callback.onError(error.getMessage());
+                    }
+                });
+    }
+}
