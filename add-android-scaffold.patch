@@ -0,0 +1,32 @@
+package com.gymbagrut.ui.common;
+
+import android.app.Activity;
+import android.content.Intent;
+
+import com.gymbagrut.data.model.UserProfile;
+import com.gymbagrut.ui.admin.AdminDashboardActivity;
+import com.gymbagrut.ui.trainee.TraineeDashboardActivity;
+import com.gymbagrut.ui.trainer.TrainerDashboardActivity;
+
+/**
+ * Simple navigator class that routes users to the correct dashboard based on their role.
+ */
+public final class RoleNavigator {
+
+    private RoleNavigator() {
+    }
+
+    public static void openDashboard(Activity activity, UserProfile profile) {
+        Intent intent;
+        if ("trainer".equalsIgnoreCase(profile.getRole())) {
+            intent = new Intent(activity, TrainerDashboardActivity.class);
+        } else if ("admin".equalsIgnoreCase(profile.getRole())) {
+            intent = new Intent(activity, AdminDashboardActivity.class);
+        } else {
+            intent = new Intent(activity, TraineeDashboardActivity.class);
+        }
+        intent.putExtra("user_profile", profile);
+        activity.startActivity(intent);
+        activity.finish();
+    }
+}
