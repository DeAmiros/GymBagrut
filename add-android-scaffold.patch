+        if (newPurchases != null) {
+            purchases.addAll(newPurchases);
+        }
+        notifyDataSetChanged();
+    }
+
+    @NonNull
+    @Override
+    public ClientViewHolder onCreateViewHolder(@NonNull ViewGroup parent, int viewType) {
+        View view = LayoutInflater.from(parent.getContext())
+                .inflate(R.layout.item_trainer_client_card, parent, false);
+        return new ClientViewHolder(view);
+    }
+
+    @Override
+    public void onBindViewHolder(@NonNull ClientViewHolder holder, int position) {
+        TrainingPurchase purchase = purchases.get(position);
+        holder.packageNameView.setText(purchase.getPackageName());
+        holder.clientIdView.setText(holder.itemView.getContext()
+                .getString(R.string.trainer_client_id_format, purchase.getClientUid()));
+        holder.lessonsView.setText(holder.itemView.getContext()
+                .getString(R.string.purchase_lessons_remaining, purchase.getLessonsRemaining()));
+        holder.dateView.setText(holder.itemView.getContext()
+                .getString(R.string.purchase_date_format, purchase.getDatePaid()));
+    }
+
+    @Override
+    public int getItemCount() {
+        return purchases.size();
+    }
+
+    static class ClientViewHolder extends RecyclerView.ViewHolder {
+        TextView packageNameView;
+        TextView clientIdView;
+        TextView lessonsView;
+        TextView dateView;
+
+        ClientViewHolder(@NonNull View itemView) {
+            super(itemView);
+            packageNameView = itemView.findViewById(R.id.trainerClientPackageName);
+            clientIdView = itemView.findViewById(R.id.trainerClientId);
+            lessonsView = itemView.findViewById(R.id.trainerClientLessons);
+            dateView = itemView.findViewById(R.id.trainerClientDate);
+        }
+    }
+}
diff --git a/app/src/main/java/com/gymbagrut/ui/trainer/adapters/TrainerPackageAdapter.java b/app/src/main/java/com/gymbagrut/ui/trainer/adapters/TrainerPackageAdapter.java
