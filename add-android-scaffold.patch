+import com.google.android.gms.tasks.OnCompleteListener;
+import com.google.android.gms.tasks.Task;
+import com.google.firebase.database.DataSnapshot;
+import com.google.firebase.database.DatabaseError;
+import com.google.firebase.database.DatabaseReference;
+import com.google.firebase.database.FirebaseDatabase;
+import com.google.firebase.database.Query;
+import com.google.firebase.database.ValueEventListener;
+
+import java.util.ArrayList;
+import java.util.List;
+
+/**
+ * Provides CRUD operations for packages and purchase tracking for trainees.
+ */
+public class PackageRepository {
+
+    private final DatabaseReference databaseReference;
+
+    public PackageRepository() {
+        databaseReference = FirebaseDatabase.getInstance().getReference();
+    }
+
+    public void fetchActivePackages(final ListDataCallback<TrainingPackage> callback) {
+        Query query = databaseReference.child(FirebasePaths.PACKAGES)
+                .orderByChild("status")
+                .equalTo("active");
+        query.addListenerForSingleValueEvent(new ValueEventListener() {
+            @Override
+            public void onDataChange(@NonNull DataSnapshot snapshot) {
+                List<TrainingPackage> packages = new ArrayList<>();
+                for (DataSnapshot child : snapshot.getChildren()) {
+                    TrainingPackage trainingPackage = child.getValue(TrainingPackage.class);
+                    if (trainingPackage != null) {
+                        packages.add(trainingPackage);
+                    }
+                }
+                callback.onSuccess(packages);
+            }
+
+            @Override
+            public void onCancelled(@NonNull DatabaseError error) {
+                callback.onError(error.getMessage());
+            }
+        });
+    }
+
+    public void fetchTrainerPackages(String trainerUid, final ListDataCallback<TrainingPackage> callback) {
+        Query query = databaseReference.child(FirebasePaths.PACKAGES)
+                .orderByChild("teacherUid")
+                .equalTo(trainerUid);
+        query.addListenerForSingleValueEvent(new ValueEventListener() {
+            @Override
+            public void onDataChange(@NonNull DataSnapshot snapshot) {
+                List<TrainingPackage> packages = new ArrayList<>();
+                for (DataSnapshot child : snapshot.getChildren()) {
+                    TrainingPackage trainingPackage = child.getValue(TrainingPackage.class);
+                    if (trainingPackage != null) {
+                        packages.add(trainingPackage);
+                    }
+                }
+                callback.onSuccess(packages);
+            }
+
+            @Override
+            public void onCancelled(@NonNull DatabaseError error) {
+                callback.onError(error.getMessage());
+            }
+        });
+    }
+
+    public void fetchPurchasesForClient(String clientUid, final ListDataCallback<TrainingPurchase> callback) {
+        Query query = databaseReference.child(FirebasePaths.TRAINING_USERS)
+                .orderByChild("clientUid")
+                .equalTo(clientUid);
+        query.addValueEventListener(new ValueEventListener() {
+            @Override
+            public void onDataChange(@NonNull DataSnapshot snapshot) {
+                List<TrainingPurchase> purchases = new ArrayList<>();
+                for (DataSnapshot child : snapshot.getChildren()) {
+                    TrainingPurchase purchase = child.getValue(TrainingPurchase.class);
+                    if (purchase != null) {
+                        purchases.add(purchase);
+                    }
+                }
+                callback.onSuccess(purchases);
+            }
+
+            @Override
+            public void onCancelled(@NonNull DatabaseError error) {
+                callback.onError(error.getMessage());
+            }
+        });
+    }
+
+    public void fetchPurchasesForTrainer(String trainerUid, final ListDataCallback<TrainingPurchase> callback) {
+        Query query = databaseReference.child(FirebasePaths.TRAINING_USERS)
+                .orderByChild("teacherUid")
+                .equalTo(trainerUid);
+        query.addValueEventListener(new ValueEventListener() {
+            @Override
+            public void onDataChange(@NonNull DataSnapshot snapshot) {
+                List<TrainingPurchase> purchases = new ArrayList<>();
+                for (DataSnapshot child : snapshot.getChildren()) {
+                    TrainingPurchase purchase = child.getValue(TrainingPurchase.class);
+                    if (purchase != null) {
+                        purchases.add(purchase);
+                    }
+                }
+                callback.onSuccess(purchases);
+            }
+
+            @Override
+            public void onCancelled(@NonNull DatabaseError error) {
+                callback.onError(error.getMessage());
+            }
+        });
+    }
+
+    public void savePackage(final TrainingPackage trainingPackage, final DataCallback<TrainingPackage> callback) {
+        DatabaseReference packagesRef = databaseReference.child(FirebasePaths.PACKAGES);
+        DatabaseReference targetRef;
+        if (trainingPackage.getPackageId() == null || trainingPackage.getPackageId().isEmpty()) {
+            targetRef = packagesRef.push();
+            trainingPackage.setPackageId(targetRef.getKey());
+        } else {
+            targetRef = packagesRef.child(trainingPackage.getPackageId());
+        }
+        trainingPackage.setUpdatedAt(System.currentTimeMillis());
+        targetRef.setValue(trainingPackage).addOnCompleteListener(new OnCompleteListener<Void>() {
+            @Override
+            public void onComplete(@NonNull Task<Void> task) {
+                if (task.isSuccessful()) {
+                    callback.onSuccess(trainingPackage);
+                } else {
+                    String message = task.getException() != null
+                            ? task.getException().getMessage()
+                            : "Unable to save package.";
+                    callback.onError(message);
+                }
+            }
+        });
+    }
+
+    public void recordPurchase(final TrainingPurchase purchase, final CompletionCallback callback) {
+        DatabaseReference purchasesRef = databaseReference.child(FirebasePaths.TRAINING_USERS);
+        DatabaseReference newPurchaseRef;
+        if (purchase.getPurchaseId() == null || purchase.getPurchaseId().isEmpty()) {
+            newPurchaseRef = purchasesRef.push();
+            purchase.setPurchaseId(newPurchaseRef.getKey());
+        } else {
+            newPurchaseRef = purchasesRef.child(purchase.getPurchaseId());
+        }
+        newPurchaseRef.setValue(purchase).addOnCompleteListener(new OnCompleteListener<Void>() {
+            @Override
+            public void onComplete(@NonNull Task<Void> task) {
+                boolean success = task.isSuccessful();
+                String message = success ? "Purchase stored." :
+                        task.getException() != null
+                                ? task.getException().getMessage()
+                                : "Unable to store purchase.";
+                callback.onComplete(success, message);
+            }
+        });
+    }
