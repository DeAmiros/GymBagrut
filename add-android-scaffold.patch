+package com.gymbagrut.ui.packageeditor;
+
+import android.content.Context;
+import android.content.Intent;
+import android.os.Bundle;
+import android.text.TextUtils;
+import android.view.View;
+import android.widget.ArrayAdapter;
+import android.widget.AutoCompleteTextView;
+import android.widget.ProgressBar;
+import android.widget.Toast;
+
+import androidx.annotation.Nullable;
+import androidx.appcompat.app.AppCompatActivity;
+
+import com.gymbagrut.R;
+import com.gymbagrut.data.callbacks.DataCallback;
+import com.gymbagrut.data.model.TrainingPackage;
+import com.gymbagrut.data.model.UserProfile;
+import com.gymbagrut.data.repository.PackageRepository;
+import com.google.android.material.button.MaterialButton;
+import com.google.android.material.materialswitch.MaterialSwitch;
+import com.google.android.material.textfield.TextInputEditText;
+
+/**
+ * Activity that lets trainers create or update packages.
+ */
+public class PackageEditorActivity extends AppCompatActivity {
+
+    private static final String EXTRA_TRAINER = "extra_trainer";
+    private static final String EXTRA_PACKAGE = "extra_package";
+
+    private UserProfile trainerProfile;
+    private TrainingPackage trainingPackage;
+    private PackageRepository packageRepository;
+
+    private TextInputEditText nameInput;
+    private TextInputEditText descriptionInput;
+    private TextInputEditText priceInput;
+    private TextInputEditText lessonsInput;
+    private TextInputEditText classInput;
+    private TextInputEditText logoInput;
+    private AutoCompleteTextView levelInput;
+    private AutoCompleteTextView genderInput;
+    private MaterialSwitch statusSwitch;
+    private ProgressBar progressBar;
+
+    public static void start(Context context, UserProfile trainerProfile, @Nullable TrainingPackage trainingPackage) {
+        Intent intent = new Intent(context, PackageEditorActivity.class);
+        intent.putExtra(EXTRA_TRAINER, trainerProfile);
+        if (trainingPackage != null) {
+            intent.putExtra(EXTRA_PACKAGE, trainingPackage);
+        }
+        context.startActivity(intent);
+    }
+
+    @Override
+    protected void onCreate(@Nullable Bundle savedInstanceState) {
+        super.onCreate(savedInstanceState);
+        setContentView(R.layout.activity_package_editor);
+        trainerProfile = (UserProfile) getIntent().getSerializableExtra(EXTRA_TRAINER);
+        trainingPackage = (TrainingPackage) getIntent().getSerializableExtra(EXTRA_PACKAGE);
+        if (trainerProfile == null) {
+            finish();
+            return;
+        }
+        packageRepository = new PackageRepository();
+        initViews();
+        setupDropdowns();
+        populateFields();
+        MaterialButton saveButton = findViewById(R.id.packageEditorSaveButton);
+        saveButton.setOnClickListener(new View.OnClickListener() {
+            @Override
+            public void onClick(View v) {
+                savePackage();
+            }
+        });
+    }
+
+    private void initViews() {
+        nameInput = findViewById(R.id.packageEditorNameInput);
+        descriptionInput = findViewById(R.id.packageEditorDescriptionInput);
+        priceInput = findViewById(R.id.packageEditorPriceInput);
+        lessonsInput = findViewById(R.id.packageEditorLessonsInput);
+        classInput = findViewById(R.id.packageEditorClassInput);
+        logoInput = findViewById(R.id.packageEditorLogoInput);
+        levelInput = findViewById(R.id.packageEditorLevelInput);
+        genderInput = findViewById(R.id.packageEditorGenderInput);
+        statusSwitch = findViewById(R.id.packageEditorStatusSwitch);
+        progressBar = findViewById(R.id.packageEditorProgress);
+    }
+
+    private void setupDropdowns() {
+        ArrayAdapter<String> levelAdapter = new ArrayAdapter<>(this,
+                android.R.layout.simple_dropdown_item_1line,
+                getResources().getStringArray(R.array.package_levels));
+        levelInput.setAdapter(levelAdapter);
+
+        ArrayAdapter<String> genderAdapter = new ArrayAdapter<>(this,
+                android.R.layout.simple_dropdown_item_1line,
+                getResources().getStringArray(R.array.gender_options));
+        genderInput.setAdapter(genderAdapter);
+    }
+
+    private void populateFields() {
+        if (trainingPackage == null) {
+            statusSwitch.setChecked(true);
+            return;
+        }
+        nameInput.setText(trainingPackage.getName());
+        descriptionInput.setText(trainingPackage.getDescription());
+        priceInput.setText(String.valueOf(trainingPackage.getPrice()));
+        lessonsInput.setText(String.valueOf(trainingPackage.getLessonCount()));
+        classInput.setText(trainingPackage.getClassNumber());
+        logoInput.setText(trainingPackage.getLogoUrl());
+        levelInput.setText(trainingPackage.getLevel(), false);
+        genderInput.setText(trainingPackage.getGenderTarget(), false);
+        statusSwitch.setChecked(trainingPackage.isActive());
+    }
+
+    private void savePackage() {
+        String name = valueOf(nameInput);
+        String description = valueOf(descriptionInput);
+        String priceValue = valueOf(priceInput);
+        String lessonsValue = valueOf(lessonsInput);
+        String classNumber = valueOf(classInput);
+        String logo = valueOf(logoInput);
+        String level = valueOf(levelInput);
+        String gender = valueOf(genderInput);
+
+        if (TextUtils.isEmpty(name) || TextUtils.isEmpty(priceValue) || TextUtils.isEmpty(lessonsValue)) {
+            Toast.makeText(this, R.string.package_editor_error_required, Toast.LENGTH_SHORT).show();
+            return;
+        }
+
+        double price;
+        int lessons;
+        try {
+            price = Double.parseDouble(priceValue);
+            lessons = Integer.parseInt(lessonsValue);
+        } catch (NumberFormatException exception) {
+            Toast.makeText(this, R.string.package_editor_error_number, Toast.LENGTH_SHORT).show();
+            return;
+        }
+
+        progressBar.setVisibility(View.VISIBLE);
+        final TrainingPackage packageToSave = trainingPackage != null ? trainingPackage : new TrainingPackage();
+        packageToSave.setName(name);
+        packageToSave.setDescription(description);
+        packageToSave.setPrice(price);
+        packageToSave.setLessonCount(lessons);
+        packageToSave.setClassNumber(classNumber);
+        packageToSave.setLogoUrl(logo);
+        packageToSave.setLevel(level);
+        packageToSave.setGenderTarget(gender);
+        packageToSave.setStatus(statusSwitch.isChecked() ? "active" : "inactive");
+        packageToSave.setTeacherUid(trainerProfile.getUid());
+
+        packageRepository.savePackage(packageToSave, new DataCallback<TrainingPackage>() {
+            @Override
+            public void onSuccess(TrainingPackage data) {
+                progressBar.setVisibility(View.GONE);
+                Toast.makeText(PackageEditorActivity.this, R.string.package_editor_saved, Toast.LENGTH_SHORT).show();
+                finish();
+            }
+
+            @Override
+            public void onError(String message) {
+                progressBar.setVisibility(View.GONE);
+                Toast.makeText(PackageEditorActivity.this, message, Toast.LENGTH_LONG).show();
+            }
+        });
+    }
+
+    private String valueOf(TextInputEditText editText) {
+        return editText.getText() != null ? editText.getText().toString().trim() : "";
+    }
+
+    private String valueOf(AutoCompleteTextView autoCompleteTextView) {
+        return autoCompleteTextView.getText() != null
+                ? autoCompleteTextView.getText().toString().trim()
+                : "";
+    }
+}
