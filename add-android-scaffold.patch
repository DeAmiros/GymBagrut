@@ -0,0 +1,111 @@
+package com.gymbagrut.ui.trainer.adapters;
+
+import android.view.LayoutInflater;
+import android.view.View;
+import android.view.ViewGroup;
+import android.widget.TextView;
+
+import androidx.annotation.NonNull;
+import androidx.recyclerview.widget.RecyclerView;
+
+import com.gymbagrut.R;
+import com.gymbagrut.data.model.TrainingPackage;
+import com.google.android.material.button.MaterialButton;
+
+import java.util.ArrayList;
+import java.util.List;
+
+/**
+ * Adapter presenting the trainer's packages.
+ */
+public class TrainerPackageAdapter extends RecyclerView.Adapter<TrainerPackageAdapter.PackageViewHolder> {
+
+    public interface PackageInteractionListener {
+        void onEditPackage(TrainingPackage trainingPackage);
+
+        void onToggleStatus(TrainingPackage trainingPackage);
+    }
+
+    private final List<TrainingPackage> packages;
+    private final PackageInteractionListener interactionListener;
+
+    public TrainerPackageAdapter(PackageInteractionListener interactionListener) {
+        this.packages = new ArrayList<>();
+        this.interactionListener = interactionListener;
+    }
+
+    public void updateData(List<TrainingPackage> newPackages) {
+        packages.clear();
+        if (newPackages != null) {
+            packages.addAll(newPackages);
+        }
+        notifyDataSetChanged();
+    }
+
+    @NonNull
+    @Override
+    public PackageViewHolder onCreateViewHolder(@NonNull ViewGroup parent, int viewType) {
+        View view = LayoutInflater.from(parent.getContext())
+                .inflate(R.layout.item_trainer_package_card, parent, false);
+        return new PackageViewHolder(view);
+    }
+
+    @Override
+    public void onBindViewHolder(@NonNull PackageViewHolder holder, int position) {
+        final TrainingPackage trainingPackage = packages.get(position);
+        holder.nameView.setText(trainingPackage.getName());
+        holder.descriptionView.setText(trainingPackage.getDescription());
+        holder.statusView.setText(trainingPackage.isActive()
+                ? holder.itemView.getContext().getString(R.string.trainer_package_status_active)
+                : holder.itemView.getContext().getString(R.string.trainer_package_status_inactive));
+        holder.levelView.setText(holder.itemView.getContext().getString(R.string.package_level_format,
+                trainingPackage.getLevel()));
+        holder.priceView.setText(holder.itemView.getContext().getString(R.string.package_price_format,
+                trainingPackage.getPrice()));
+        holder.toggleButton.setText(trainingPackage.isActive()
+                ? R.string.trainer_package_deactivate
+                : R.string.trainer_package_activate);
+        holder.toggleButton.setOnClickListener(new View.OnClickListener() {
+            @Override
+            public void onClick(View v) {
+                if (interactionListener != null) {
+                    interactionListener.onToggleStatus(trainingPackage);
+                }
+            }
+        });
+        holder.editButton.setOnClickListener(new View.OnClickListener() {
+            @Override
+            public void onClick(View v) {
+                if (interactionListener != null) {
+                    interactionListener.onEditPackage(trainingPackage);
+                }
+            }
+        });
+    }
+
+    @Override
+    public int getItemCount() {
+        return packages.size();
+    }
+
+    static class PackageViewHolder extends RecyclerView.ViewHolder {
+        TextView nameView;
+        TextView descriptionView;
+        TextView statusView;
+        TextView levelView;
+        TextView priceView;
+        MaterialButton toggleButton;
+        MaterialButton editButton;
+
+        PackageViewHolder(@NonNull View itemView) {
+            super(itemView);
+            nameView = itemView.findViewById(R.id.trainerPackageName);
+            descriptionView = itemView.findViewById(R.id.trainerPackageDescription);
+            statusView = itemView.findViewById(R.id.trainerPackageStatus);
+            levelView = itemView.findViewById(R.id.trainerPackageLevel);
+            priceView = itemView.findViewById(R.id.trainerPackagePrice);
+            toggleButton = itemView.findViewById(R.id.trainerPackageToggleButton);
+            editButton = itemView.findViewById(R.id.trainerPackageEditButton);
+        }
+    }
+}
