+package com.gymbagrut.ui.splash;
+
+import android.content.Intent;
+import android.os.Bundle;
+import android.view.View;
+import android.widget.ProgressBar;
+
+import androidx.annotation.Nullable;
+import androidx.appcompat.app.AppCompatActivity;
+
+import com.gymbagrut.R;
+import com.gymbagrut.data.callbacks.DataCallback;
+import com.gymbagrut.data.model.UserProfile;
+import com.gymbagrut.data.repository.AuthRepository;
+import com.gymbagrut.data.repository.UserRepository;
+import com.gymbagrut.ui.auth.LoginActivity;
+import com.gymbagrut.ui.common.RoleNavigator;
+import com.google.firebase.auth.FirebaseUser;
+
+/**
+ * Lightweight splash screen that decides where the user should go when the app launches.
+ */
+public class SplashActivity extends AppCompatActivity {
+
+    private ProgressBar progressBar;
+    private AuthRepository authRepository;
+    private UserRepository userRepository;
+
+    @Override
+    protected void onCreate(@Nullable Bundle savedInstanceState) {
+        super.onCreate(savedInstanceState);
+        setContentView(R.layout.activity_splash);
+        progressBar = findViewById(R.id.splashProgress);
+        authRepository = new AuthRepository();
+        userRepository = new UserRepository();
+        decideNextScreen();
+    }
+
+    private void decideNextScreen() {
+        FirebaseUser firebaseUser = authRepository.getCurrentUser();
+        if (firebaseUser == null) {
+            openLogin();
+            return;
+        }
+        progressBar.setVisibility(View.VISIBLE);
+        userRepository.fetchUserProfile(firebaseUser.getUid(), new DataCallback<UserProfile>() {
+            @Override
+            public void onSuccess(UserProfile data) {
+                progressBar.setVisibility(View.GONE);
+                RoleNavigator.openDashboard(SplashActivity.this, data);
+            }
+
+            @Override
+            public void onError(String message) {
+                progressBar.setVisibility(View.GONE);
+                openLogin();
+            }
+        });
+    }
+
+    private void openLogin() {
+        startActivity(new Intent(this, LoginActivity.class));
+        finish();
+    }
+}
