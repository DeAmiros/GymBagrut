+import com.google.android.material.appbar.MaterialToolbar;
+
+import java.text.SimpleDateFormat;
+import java.util.Date;
+import java.util.List;
+import java.util.Locale;
+
+/**
+ * Dashboard for trainees displaying available packages and their current balance.
+ */
+public class TraineeDashboardActivity extends AppCompatActivity implements AvailablePackageAdapter.PackageActionListener {
+
+    private UserProfile userProfile;
+    private PackageRepository packageRepository;
+    private AvailablePackageAdapter packageAdapter;
+    private PurchaseHistoryAdapter purchaseHistoryAdapter;
+
+    private ProgressBar packagesProgressBar;
+    private ProgressBar purchasesProgressBar;
+    private TextView packagesEmptyView;
+    private TextView purchasesEmptyView;
+    private TextView welcomeTextView;
+
+    @Override
+    protected void onCreate(@Nullable Bundle savedInstanceState) {
+        super.onCreate(savedInstanceState);
+        setContentView(R.layout.activity_trainee_dashboard);
+        userProfile = (UserProfile) getIntent().getSerializableExtra("user_profile");
+        if (userProfile == null) {
+            finish();
+            return;
+        }
+        packageRepository = new PackageRepository();
+        initViews();
+        setupRecyclerViews();
+        loadPackages();
+        loadPurchases();
+    }
+
+    private void initViews() {
+        MaterialToolbar toolbar = findViewById(R.id.traineeToolbar);
+        setSupportActionBar(toolbar);
+        welcomeTextView = findViewById(R.id.traineeWelcomeText);
+        welcomeTextView.setText(getString(R.string.trainee_welcome_format, userProfile.getFirstName()));
+        packagesProgressBar = findViewById(R.id.traineePackagesProgress);
+        purchasesProgressBar = findViewById(R.id.traineePurchasesProgress);
+        packagesEmptyView = findViewById(R.id.traineePackagesEmptyView);
+        purchasesEmptyView = findViewById(R.id.traineePurchasesEmptyView);
+        TextView phoneTextView = findViewById(R.id.traineePhoneText);
+        TextView emailTextView = findViewById(R.id.traineeEmailText);
+        TextView goalsTextView = findViewById(R.id.traineePeakText);
+        phoneTextView.setText(userProfile.getPhone());
+        emailTextView.setText(userProfile.getEmail());
+        goalsTextView.setText(userProfile.getPeak());
+    }
+
+    private void setupRecyclerViews() {
+        RecyclerView packagesRecyclerView = findViewById(R.id.traineePackagesRecycler);
+        RecyclerView purchasesRecyclerView = findViewById(R.id.traineePurchasesRecycler);
+        packagesRecyclerView.setLayoutManager(new LinearLayoutManager(this, RecyclerView.HORIZONTAL, false));
+        purchasesRecyclerView.setLayoutManager(new LinearLayoutManager(this));
+        packageAdapter = new AvailablePackageAdapter(this);
+        packagesRecyclerView.setAdapter(packageAdapter);
+        purchaseHistoryAdapter = new PurchaseHistoryAdapter();
+        purchasesRecyclerView.setAdapter(purchaseHistoryAdapter);
+    }
+
+    private void loadPackages() {
+        packagesProgressBar.setVisibility(View.VISIBLE);
+        packageRepository.fetchActivePackages(new ListDataCallback<TrainingPackage>() {
+            @Override
+            public void onSuccess(List<TrainingPackage> data) {
+                packagesProgressBar.setVisibility(View.GONE);
+                packagesEmptyView.setVisibility(data.isEmpty() ? View.VISIBLE : View.GONE);
+                packageAdapter.updateData(data);
+            }
+
+            @Override
+            public void onError(String message) {
+                packagesProgressBar.setVisibility(View.GONE);
+                packagesEmptyView.setVisibility(View.VISIBLE);
+                Toast.makeText(TraineeDashboardActivity.this, message, Toast.LENGTH_LONG).show();
+            }
+        });
+    }
+
+    private void loadPurchases() {
+        purchasesProgressBar.setVisibility(View.VISIBLE);
+        packageRepository.fetchPurchasesForClient(userProfile.getUid(), new ListDataCallback<TrainingPurchase>() {
+            @Override
+            public void onSuccess(List<TrainingPurchase> data) {
+                purchasesProgressBar.setVisibility(View.GONE);
+                purchasesEmptyView.setVisibility(data.isEmpty() ? View.VISIBLE : View.GONE);
+                purchaseHistoryAdapter.updateData(data);
+            }
+
+            @Override
+            public void onError(String message) {
+                purchasesProgressBar.setVisibility(View.GONE);
+                purchasesEmptyView.setVisibility(View.VISIBLE);
+                Toast.makeText(TraineeDashboardActivity.this, message, Toast.LENGTH_LONG).show();
+            }
+        });
+    }
+
+    @Override
+    public void onPackageSelected(TrainingPackage trainingPackage) {
+        TrainingPurchase purchase = new TrainingPurchase();
+        purchase.setPackageUid(trainingPackage.getPackageId());
+        purchase.setPackageName(trainingPackage.getName());
+        purchase.setTeacherUid(trainingPackage.getTeacherUid());
+        purchase.setClientUid(userProfile.getUid());
+        purchase.setLessonsRemaining(trainingPackage.getLessonCount());
+        purchase.setPricePaid(trainingPackage.getPrice());
+        purchase.setClassNumber(trainingPackage.getClassNumber());
+        SimpleDateFormat dateFormat = new SimpleDateFormat("yyyy-MM-dd", Locale.getDefault());
+        purchase.setDatePaid(dateFormat.format(new Date()));
+        purchase.setDate(dateFormat.format(new Date()));
+        purchase.setStartHour(getString(R.string.trainee_default_start_hour));
+        purchase.setComment(getString(R.string.trainee_purchase_comment));
+
+        packageRepository.recordPurchase(purchase, (success, message) -> {
+            Toast.makeText(TraineeDashboardActivity.this, message, Toast.LENGTH_LONG).show();
+            if (success) {
+                loadPurchases();
+            }
+        });
+    }
+}
