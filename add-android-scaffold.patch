+
+    public interface PackageActionListener {
+        void onPackageSelected(TrainingPackage trainingPackage);
+    }
+
+    private final List<TrainingPackage> packages;
+    private final PackageActionListener actionListener;
+
+    public AvailablePackageAdapter(PackageActionListener actionListener) {
+        this.packages = new ArrayList<>();
+        this.actionListener = actionListener;
+    }
+
+    public void updateData(List<TrainingPackage> newPackages) {
+        packages.clear();
+        if (newPackages != null) {
+            packages.addAll(newPackages);
+        }
+        notifyDataSetChanged();
+    }
+
+    @NonNull
+    @Override
+    public PackageViewHolder onCreateViewHolder(@NonNull ViewGroup parent, int viewType) {
+        View view = LayoutInflater.from(parent.getContext())
+                .inflate(R.layout.item_package_card, parent, false);
+        return new PackageViewHolder(view);
+    }
+
+    @Override
+    public void onBindViewHolder(@NonNull PackageViewHolder holder, int position) {
+        final TrainingPackage trainingPackage = packages.get(position);
+        holder.nameView.setText(trainingPackage.getName());
+        holder.descriptionView.setText(trainingPackage.getDescription());
+        holder.levelView.setText(holder.itemView.getContext().getString(R.string.package_level_format,
+                trainingPackage.getLevel()));
+        holder.priceView.setText(holder.itemView.getContext().getString(R.string.package_price_format,
+                trainingPackage.getPrice()));
+        holder.lessonsView.setText(holder.itemView.getContext().getString(R.string.package_lessons_format,
+                trainingPackage.getLessonCount()));
+        holder.purchaseButton.setOnClickListener(new View.OnClickListener() {
+            @Override
+            public void onClick(View v) {
+                if (actionListener != null) {
+                    actionListener.onPackageSelected(trainingPackage);
+                }
+            }
+        });
+    }
+
+    @Override
+    public int getItemCount() {
+        return packages.size();
+    }
+
+    static class PackageViewHolder extends RecyclerView.ViewHolder {
+
+        TextView nameView;
+        TextView descriptionView;
+        TextView levelView;
+        TextView priceView;
+        TextView lessonsView;
+        MaterialButton purchaseButton;
+
+        PackageViewHolder(@NonNull View itemView) {
+            super(itemView);
+            nameView = itemView.findViewById(R.id.packageName);
+            descriptionView = itemView.findViewById(R.id.packageDescription);
+            levelView = itemView.findViewById(R.id.packageLevel);
+            priceView = itemView.findViewById(R.id.packagePrice);
+            lessonsView = itemView.findViewById(R.id.packageLessons);
+            purchaseButton = itemView.findViewById(R.id.packageActionButton);
+        }
+    }
+}
