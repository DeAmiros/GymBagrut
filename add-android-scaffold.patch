+package com.gymbagrut.ui.admin;
+
+import android.content.Context;
+import android.content.Intent;
+import android.os.Bundle;
+import android.text.TextUtils;
+import android.view.View;
+import android.widget.ProgressBar;
+import android.widget.Toast;
+
+import androidx.annotation.Nullable;
+import androidx.appcompat.app.AppCompatActivity;
+
+import com.gymbagrut.R;
+import com.gymbagrut.data.callbacks.DataCallback;
+import com.gymbagrut.data.model.TeacherDetails;
+import com.gymbagrut.data.model.UserProfile;
+import com.gymbagrut.data.repository.AuthRepository;
+import com.google.android.material.button.MaterialButton;
+import com.google.android.material.textfield.TextInputEditText;
+import com.google.firebase.auth.FirebaseAuth;
+
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.List;
+
+/**
+ * Flow used by administrators to register trainers.
+ */
+public class TrainerRegistrationActivity extends AppCompatActivity {
+
+    private TextInputEditText firstNameInput;
+    private TextInputEditText lastNameInput;
+    private TextInputEditText emailInput;
+    private TextInputEditText passwordInput;
+    private TextInputEditText confirmPasswordInput;
+    private TextInputEditText phoneInput;
+    private TextInputEditText addressInput;
+    private TextInputEditText jobsInput;
+    private TextInputEditText startDateInput;
+    private TextInputEditText biographyInput;
+    private TextInputEditText experienceInput;
+    private TextInputEditText adminEmailInput;
+    private TextInputEditText adminPasswordInput;
+    private ProgressBar progressBar;
+
+    private AuthRepository authRepository;
+
+    public static void start(Context context) {
+        Intent intent = new Intent(context, TrainerRegistrationActivity.class);
+        context.startActivity(intent);
+    }
+
+    @Override
+    protected void onCreate(@Nullable Bundle savedInstanceState) {
+        super.onCreate(savedInstanceState);
+        setContentView(R.layout.activity_trainer_registration);
+        authRepository = new AuthRepository();
+        initViews();
+        MaterialButton registerButton = findViewById(R.id.trainerRegisterActionButton);
+        registerButton.setOnClickListener(new View.OnClickListener() {
+            @Override
+            public void onClick(View v) {
+                registerTrainer();
+            }
+        });
+    }
+
+    private void initViews() {
+        firstNameInput = findViewById(R.id.trainerRegisterFirstNameInput);
+        lastNameInput = findViewById(R.id.trainerRegisterLastNameInput);
+        emailInput = findViewById(R.id.trainerRegisterEmailInput);
+        passwordInput = findViewById(R.id.trainerRegisterPasswordInput);
+        confirmPasswordInput = findViewById(R.id.trainerRegisterConfirmPasswordInput);
+        phoneInput = findViewById(R.id.trainerRegisterPhoneInput);
+        addressInput = findViewById(R.id.trainerRegisterAddressInput);
+        jobsInput = findViewById(R.id.trainerRegisterJobsInput);
+        startDateInput = findViewById(R.id.trainerRegisterStartDateInput);
+        biographyInput = findViewById(R.id.trainerRegisterBiographyInput);
+        experienceInput = findViewById(R.id.trainerRegisterExperienceInput);
+        adminEmailInput = findViewById(R.id.trainerRegisterAdminEmailInput);
+        adminPasswordInput = findViewById(R.id.trainerRegisterAdminPasswordInput);
+        progressBar = findViewById(R.id.trainerRegisterProgressBar);
+        if (FirebaseAuth.getInstance().getCurrentUser() != null) {
+            adminEmailInput.setText(FirebaseAuth.getInstance().getCurrentUser().getEmail());
+        }
+    }
+
+    private void registerTrainer() {
+        final String firstName = valueOf(firstNameInput);
+        final String lastName = valueOf(lastNameInput);
+        final String email = valueOf(emailInput);
+        final String password = valueOf(passwordInput);
+        final String confirmPassword = valueOf(confirmPasswordInput);
+        final String phone = valueOf(phoneInput);
+        final String address = valueOf(addressInput);
+        final String jobsRaw = valueOf(jobsInput);
+        final String startDate = valueOf(startDateInput);
+        final String biography = valueOf(biographyInput);
+        final String experienceValue = valueOf(experienceInput);
+        final String adminEmail = valueOf(adminEmailInput);
+        final String adminPassword = valueOf(adminPasswordInput);
+
+        if (TextUtils.isEmpty(firstName) || TextUtils.isEmpty(lastName) ||
+                TextUtils.isEmpty(email) || TextUtils.isEmpty(password) ||
+                TextUtils.isEmpty(adminEmail) || TextUtils.isEmpty(adminPassword)) {
+            Toast.makeText(this, R.string.trainer_register_error_required, Toast.LENGTH_SHORT).show();
+            return;
+        }
+
+        if (!TextUtils.equals(password, confirmPassword)) {
+            Toast.makeText(this, R.string.register_error_password_match, Toast.LENGTH_SHORT).show();
+            return;
+        }
+
+        int experienceYears = 0;
+        if (!TextUtils.isEmpty(experienceValue)) {
+            try {
+                experienceYears = Integer.parseInt(experienceValue);
+            } catch (NumberFormatException exception) {
+                Toast.makeText(this, R.string.trainer_register_error_number, Toast.LENGTH_SHORT).show();
+                return;
+            }
+        }
+
+        List<String> jobs = new ArrayList<>();
+        if (!TextUtils.isEmpty(jobsRaw)) {
+            jobs = Arrays.asList(jobsRaw.split(","));
+            for (int i = 0; i < jobs.size(); i++) {
+                jobs.set(i, jobs.get(i).trim());
+            }
+        }
+
+        progressBar.setVisibility(View.VISIBLE);
+        final UserProfile trainerProfile = new UserProfile();
+        trainerProfile.setFirstName(firstName);
+        trainerProfile.setLastName(lastName);
+        trainerProfile.setEmail(email);
+        trainerProfile.setPhone(phone);
+        trainerProfile.setAddress(address);
+        trainerProfile.setStatus("active");
+        trainerProfile.setRole("trainer");
+        trainerProfile.setTeacherId("0");
+
+        final TeacherDetails teacherDetails = new TeacherDetails();
+        teacherDetails.setJobs(jobs);
+        teacherDetails.setStartDate(startDate);
+        teacherDetails.setBiography(biography);
+        teacherDetails.setExperienceYears(experienceYears);
+
+        authRepository.registerTrainer(trainerProfile, teacherDetails, password, adminEmail, adminPassword,
+                new DataCallback<UserProfile>() {
+                    @Override
+                    public void onSuccess(UserProfile data) {
+                        progressBar.setVisibility(View.GONE);
+                        Toast.makeText(TrainerRegistrationActivity.this,
+                                R.string.trainer_register_success, Toast.LENGTH_SHORT).show();
+                        finish();
+                    }
+
+                    @Override
+                    public void onError(String message) {
+                        progressBar.setVisibility(View.GONE);
+                        Toast.makeText(TrainerRegistrationActivity.this, message, Toast.LENGTH_LONG).show();
+                    }
+                });
+    }
+
+    private String valueOf(TextInputEditText editText) {
+        return editText.getText() != null ? editText.getText().toString().trim() : "";
+    }
+}
