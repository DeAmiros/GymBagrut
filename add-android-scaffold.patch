+package com.gymbagrut.ui.admin.adapters;
+
+import android.view.LayoutInflater;
+import android.view.View;
+import android.view.ViewGroup;
+import android.widget.TextView;
+
+import androidx.annotation.NonNull;
+import androidx.recyclerview.widget.RecyclerView;
+
+import com.gymbagrut.R;
+import com.gymbagrut.data.model.UserProfile;
+import com.google.android.material.button.MaterialButton;
+
+import java.util.ArrayList;
+import java.util.List;
+
+/**
+ * Adapter used by the admin dashboard to display users.
+ */
+public class AdminUserAdapter extends RecyclerView.Adapter<AdminUserAdapter.UserViewHolder> {
+
+    public interface UserActionListener {
+        void onToggleStatus(UserProfile userProfile);
+    }
+
+    private final List<UserProfile> users;
+    private final UserActionListener actionListener;
+
+    public AdminUserAdapter(UserActionListener actionListener) {
+        this.users = new ArrayList<>();
+        this.actionListener = actionListener;
+    }
+
+    public void updateData(List<UserProfile> newUsers) {
+        users.clear();
+        if (newUsers != null) {
+            users.addAll(newUsers);
+        }
+        notifyDataSetChanged();
+    }
+
+    @NonNull
+    @Override
+    public UserViewHolder onCreateViewHolder(@NonNull ViewGroup parent, int viewType) {
+        View view = LayoutInflater.from(parent.getContext())
+                .inflate(R.layout.item_admin_user_card, parent, false);
+        return new UserViewHolder(view);
+    }
+
+    @Override
+    public void onBindViewHolder(@NonNull UserViewHolder holder, int position) {
+        final UserProfile userProfile = users.get(position);
+        holder.nameView.setText(userProfile.getFullName());
+        holder.emailView.setText(userProfile.getEmail());
+        holder.roleView.setText(holder.itemView.getContext()
+                .getString(R.string.admin_user_role_format, userProfile.getRole()));
+        holder.statusView.setText(holder.itemView.getContext()
+                .getString(R.string.admin_user_status_format, userProfile.getStatus()));
+        holder.toggleButton.setText("active".equalsIgnoreCase(userProfile.getStatus())
+                ? R.string.admin_user_deactivate
+                : R.string.admin_user_activate);
+        holder.toggleButton.setOnClickListener(new View.OnClickListener() {
+            @Override
+            public void onClick(View v) {
+                if (actionListener != null) {
+                    actionListener.onToggleStatus(userProfile);
+                }
+            }
+        });
+    }
+
+    @Override
+    public int getItemCount() {
+        return users.size();
+    }
+
+    static class UserViewHolder extends RecyclerView.ViewHolder {
+        TextView nameView;
+        TextView emailView;
+        TextView roleView;
+        TextView statusView;
+        MaterialButton toggleButton;
+
+        UserViewHolder(@NonNull View itemView) {
+            super(itemView);
+            nameView = itemView.findViewById(R.id.adminUserName);
+            emailView = itemView.findViewById(R.id.adminUserEmail);
+            roleView = itemView.findViewById(R.id.adminUserRole);
+            statusView = itemView.findViewById(R.id.adminUserStatus);
+            toggleButton = itemView.findViewById(R.id.adminUserToggleButton);
+        }
+    }
+}
